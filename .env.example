# Safe local values only. Provider keys (ANTHROPIC_API_KEY, OPENROUTER_API_KEY) are NOT set here:
# they come from the shared file through bin/with-provider-env (see docker-compose.yml header).
POSTGRES_PASSWORD=ls_dev_only
MIGRATE_DATABASE_URL=postgres://ls:ls_dev_only@postgres:5432/ls
DATABASE_URL=postgres://ls_app:ls_app_dev_only@postgres:5432/ls
COLLAB_INTERNAL_TOKEN=dev-collab-token-change-me
AUDIT_HASH_SALT=dev-audit-salt-change-me
MODEL_PROVIDER_MODE=stub
BUILD_ID=dev
